<idea-plugin>
    <id>com.driftbox.bird</id>
    <name>Driftbox Bird</name>
    <version>1.0.0</version>
    <vendor email="elijamesau@gmail.com" url="https://github.com/elijamesku">Eli James</vendor>

    <description><![CDATA[
    A Flappy Bird minigame inside your IDE. Take a break between deploys.<br><br>
    <b>How to play:</b> Tools → Driftbox Bird, or click the bird icon in the bottom tool window bar.<br>
    Press Space or click to flap. Dodge the pipes. Beat your high score.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Driftbox Bird"
                    anchor="right"
                    secondary="true"
                    icon="/game/bird-icon.svg"
                    factoryClass="com.driftbox.bird.BirdToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="DriftboxBird.Open"
                class="com.driftbox.bird.OpenBirdAction"
                text="Driftbox Bird"
                description="Open the Driftbox Bird minigame"
                icon="/game/bird-icon.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
